# Copy to .env for local development (never commit the real .env).
# On Render, set these in the dashboard under Environment.

# From MongoDB Atlas -> Database -> Connect -> Drivers. Add your password and
# allow network access from 0.0.0.0/0 (or Render's IPs).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB_NAME=tarang

# A long random string. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

JWT_TTL_DAYS=30
CORS_ORIGINS=*
